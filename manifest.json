{
  "manifest_version": 3,
  "name": "딸깍 버그리포팅 (QA Capture to ClickUp)",
  "version": "0.1.0",
  "description": "화면 캡처·영상 녹화·주석 편집을 거쳐 ClickUp에 원클릭으로 버그 리포트를 등록하는 QA 도구.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "딸깍 버그리포팅 — 클릭하여 패널 열기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.clickup.com/*",
    "<all_urls>"
  ]
}
